    <sec:references source="CVE" id="CVE-2026-107902">https://www.cve.org/CVERecord?id=CVE-2026-107902</sec:references>
    <sec:references title="境界外読み取り(CWE-125)" id="CWE-125">https://cwe.mitre.org/data/definitions/125.html</sec:references>
    <sec:references title="解放済みメモリの使用(CWE-416)" id="CWE-416">https://cwe.mitre.org/data/definitions/416.html</sec:references>
    <sec:cpe version="2.2" vendor="富士電機" product="TELLUS">cpe:/a:fujielectric:tellus</sec:cpe>
    <sec:cpe version="2.2" vendor="富士電機" product="TELLUS Lite">cpe:/a:fujielectric:tellus_lite</sec:cpe>
    <sec:cvss version="3.0" score="7.1" type="Base" severity="High" vector="CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:N/A:H"/>
    <dc:date>2026-11-18T17:53+09:00</dc:date>
