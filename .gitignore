/private/
/.claude/

# Internal documents (kept in sbomhub-internal repo)
/docs/articles/
/docs/STATUS.md

# Test/temp files
/test-sbom*.json
/nul
docker_info.txt
docker_ps.txt

# Playwright MCP screenshots (development only)
