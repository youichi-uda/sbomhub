{
  "name": "@sbomhub/mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for SBOMHub",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sbomhub-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "//test": "The tests drive dist/index.js, so they build first. Files are listed explicitly rather than globbed: `node --test <dir>` was dropped in Node 24 and a shell glob would not expand on Windows. tool-inventory.test.mjs fails if a test file is missing from this list.",
    "test": "tsc && node --test --test-reporter=spec test/tool-contract.test.mjs test/error-paths.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
