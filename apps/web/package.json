{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "echo \"=== BUILD ENV CHECK ===\"  && echo \"CLERK_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY\" && echo \"API_URL=$NEXT_PUBLIC_API_URL\" && echo \"=== END CHECK ===\" && next build",
    "start": "next start",
    "//eslint-config": "Next 16 removed `next lint`; we invoke eslint v9 against eslint.config.mjs (flat config). M11-5 #80.",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:schemas": "node --test src/lib/form-schemas/__tests__/form-schemas.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:test": "cross-env NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= CLERK_SECRET_KEY= next dev"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.6",
    "@clerk/nextjs": "^7.9.25",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.107.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
