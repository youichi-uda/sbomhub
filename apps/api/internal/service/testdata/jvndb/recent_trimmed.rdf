  <item rdf:about="https://jvndb.jvn.jp/ja/contents/2026/JVNDB-2026-039068.html">
    <title>ISC BINDにおける複数の脆弱性（2026年10月）</title>
    <link>https://jvndb.jvn.jp/ja/contents/2026/JVNDB-2026-039068.html</link>
    <description>&lt;ul&gt;&lt;li&gt;&lt;a href='https://kb.isc.org/docs/cve-2026-19630' target='_blank'&gt;CVE-2026-19630: Amplified resource exhaustion in inbound message processing&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href='https://kb.isc.org/docs/cve-2026-94300' target='_blank'&gt;CVE-2026-94300: Concurrent GSS-TSIG messages corrupt memory&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href='https://kb.isc.org/docs/cve-2026-96888' target='_blank'&gt;CVE-2026-96888: named may terminate unexpectedly when a redirect zone is used with strict QNAME minimization&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href='https://kb.isc.org/docs/cve-2026-97313' target='_blank'&gt;CVE-2026-97313: Specific RPZ configurations and query patterns may result in an unexpected exit&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;</description>
    <sec:identifier>JVNDB-2026-039068</sec:identifier>
    <sec:references source="JVN" id="JVNVU#91196958">https://jvn.jp/vu/JVNVU91196958/index.html</sec:references>
    <sec:references source="CVE" id="CVE-2026-19630">https://www.cve.org/CVERecord?id=CVE-2026-19630</sec:references>
    <sec:references source="CVE" id="CVE-2026-94300">https://www.cve.org/CVERecord?id=CVE-2026-94300</sec:references>
    <sec:references source="CVE" id="CVE-2026-96888">https://www.cve.org/CVERecord?id=CVE-2026-96888</sec:references>
    <sec:references source="CVE" id="CVE-2026-97313">https://www.cve.org/CVERecord?id=CVE-2026-97313</sec:references>
    <sec:references source="関連文書" id="株式会社日本レジストリサービス（JPRS）:（緊急）BIND 9.xの脆弱性（CPU・メモリの過剰な消費）について（CVE-2026-19630） - バージョンアップを強く推奨 -">https://jprs.jp/tech/security/2026-10-22-bind9-cve-2026-19630.html</sec:references>
    <sec:references source="関連文書" id="株式会社日本レジストリサービス（JPRS）:（緊急）BIND 9.xの脆弱性（DNSサービスの停止・リモートコード実行）について（CVE-2026-94300） - バージョンアップを強く推奨 -">https://jprs.jp/tech/security/2026-10-22-bind9-cve-2026-94300.html</sec:references>
    <sec:references source="関連文書" id="株式会社日本レジストリサービス（JPRS）:（緊急）BIND 9.xの脆弱性（DNSサービスの停止）について（CVE-2026-96888） - バージョンアップを強く推奨 -">https://jprs.jp/tech/security/2026-10-22-bind9-cve-2026-96888.html</sec:references>
    <sec:references source="関連文書" id="株式会社日本レジストリサービス（JPRS）:（緊急）BIND 9.xの脆弱性（DNSサービスの停止）について（CVE-2026-97313） - RPZを該当する設定で利用している場合のみ対象、バージョンアップを強く推奨 -">https://jprs.jp/tech/security/2026-10-22-bind9-cve-2026-97313.html</sec:references>
    <sec:cpe version="2.2" vendor="ISC, Inc." product="BIND">cpe:/a:isc:bind</sec:cpe>
