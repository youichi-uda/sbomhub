# ===========================================
# SBOMHub Backend Configuration
# ===========================================

# Core Settings
PORT=8080
DATABASE_URL=postgres://sbomhub:sbomhub@localhost:5432/sbomhub?sslmode=disable
REDIS_URL=redis://localhost:6379

# Deployment mode (codex-r18 P1): APP_ENV is the canonical variable, matching
# docker-compose.yml and the startup guards in cmd/server/main.go. The legacy
# ENVIRONMENT variable still works as a fallback when APP_ENV is unset, but new
# deployments should set APP_ENV only.
#
# M48 (FO-4): REQUIRED. There is no default — the server refuses to start when
# APP_ENV is unset or is not one of development | staging | production. This
# file is the CONTRIBUTOR template (`cd apps/api && go run ./cmd/server`), so
# "development" is correct here; the deployment template is the repository-root
# .env.example, which ships "production".
APP_ENV=development

# External APIs
NVD_API_KEY=
BASE_URL=http://localhost:3000

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ===========================================
# Clerk Authentication (SaaS mode only)
# Leave empty for self-hosted mode
#
# M48 (FO-3): "self-hosted mode" means NO AUTHENTICATION — requests to the
# Clerk-fronted API route groups are served as Owner of the default tenant with
# no credential. SBOMHUB_AUTH_MODE below must declare which mode you intend;
# the server refuses to start without it, in every environment.
# ===========================================
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# REQUIRED: clerk | anonymous. No default, nothing inferred.
#   anonymous -> CLERK_SECRET_KEY must be empty (the usual contributor setup)
#   clerk     -> CLERK_SECRET_KEY must be set (running the SaaS stack locally)
# Development is not exempt: exempting it was an early version of this guard,
# and it meant every already-installed deployment (which ships
# APP_ENV=development) would have upgraded into M48 without being asked
# anything.
SBOMHUB_AUTH_MODE=anonymous

# ===========================================
# Lemon Squeezy Billing (SaaS mode only)
# Leave empty to disable billing
# ===========================================
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_TEAM_VARIANT_ID=
